rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/characters/{characterId}
// Document ID: auto-generated or client-generated character UUID/alphanumeric string
// Description: Player character sheets saved by authenticated users in their personal vault.
//
// Fields:
//   - id: string (optional on create, but if present must equal characterId; immutable on update if present)
//   - name: string (required, 1 to 100 characters) - Character name
//   - sex: string (required, 1 to 20 characters, e.g. "Male", "Female", "Other")
//   - raceKey: string (required, 1 to 50 characters, e.g. "human", "krrk")
//   - attributes: map (required, primary attributes object ps, ag, co, pr, ws, it, mc, in, baseIn, appearance)
//   - appearance: number or map (optional, table #1-4 appearance roll result or description)
//   - appearanceInfo: map (optional, appearance metadata / modifiers)
//   - secondaryStats: map (optional, derived secondary stats)
//   - damagePoints: map (optional, hit location / damage boxes table)
//   - bgSkills: map (optional, background skill allocations)
//   - vitals: map (optional, height, mass, age, wealth, occupation)
//   - createdAt: timestamp (optional/serverTimestamp on create; immutable on update if present)
//   - updatedAt: timestamp (optional/serverTimestamp on create or update)
//   - createdAtClient: string (optional, ISO 8601 string recorded by client, max 50 chars)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Character Domain Validators
    // ===============================================================

    function allowedCharacterFields() {
      return [
        'id',
        'name',
        'sex',
        'raceKey',
        'attributes',
        'appearance',
        'appearanceInfo',
        'secondaryStats',
        'damagePoints',
        'bgSkills',
        'vitals',
        'createdAt',
        'updatedAt',
        'createdAtClient'
      ];
    }

    function requiredCharacterFields() {
      return ['name', 'sex', 'raceKey', 'attributes'];
    }

    function isValidCharacter(data, characterId) {
      return hasOnlyAllowedFields(allowedCharacterFields()) &&
        hasRequiredFields(requiredCharacterFields()) &&
        // id field validation (if provided)
        (!('id' in data) || (data.id is string && data.id == characterId)) &&
        // Core identification strings
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.sex is string && data.sex.size() > 0 && data.sex.size() <= 20 &&
        data.raceKey is string && data.raceKey.size() > 0 && data.raceKey.size() <= 50 &&
        // Primary attributes map
        data.attributes is map &&
        // Optional appearance (can be numeric roll 1-100 or map)
        (!('appearance' in data) || data.appearance is number || data.appearance is map) &&
        // Optional client creation string
        (!('createdAtClient' in data) || (data.createdAtClient is string && data.createdAtClient.size() <= 50)) &&
        // Optional timestamps
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp) &&
        // Optional structured maps
        (!('appearanceInfo' in data) || data.appearanceInfo is map) &&
        (!('secondaryStats' in data) || data.secondaryStats is map) &&
        (!('damagePoints' in data) || data.damagePoints is map) &&
        (!('bgSkills' in data) || data.bgSkills is map) &&
        (!('vitals' in data) || data.vitals is map);
    }

    // ===============================================================
    // Default Deny Rule
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // User Characters Collection
    // ===============================================================
    match /users/{userId}/characters/{characterId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        isValidCharacter(request.resource.data, characterId);

      allow update: if isOwner(userId) &&
        isValidCharacter(request.resource.data, characterId) &&
        // Immutable field protection: if field existed previously, it cannot change
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if isOwner(userId);
    }
  }
}
