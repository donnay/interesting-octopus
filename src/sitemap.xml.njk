---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
  {%- if item.url and not item.data.excludeFromSitemap and item.url != "/404.html" and item.url != "/success/" %}
  <url>
    <loc>https://genesisrpg.com{{ item.url }}</loc>
    {%- if item.date %}
    <lastmod>{{ item.date | dateToRfc3339 if dateToRfc3339 else "2026-11-07" }}</lastmod>
    {%- endif %}
    {%- if item.url == "/" %}
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
    {%- elif "/blog/" in item.url %}
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    {%- elif "/docs/" in item.url %}
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    {%- else %}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {%- endif %}
  </url>
  {%- endif %}
{%- endfor %}
</urlset>

